model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-PK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_business", "dim_category", "bridge_business_category", "dim_attribute", "bridge_business_attribute", "fact_review", "fact_user"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_business
ref table dim_category
ref table bridge_business_category
ref table dim_attribute
ref table bridge_business_attribute
ref table fact_review
ref table fact_user

ref cultureInfo en-US
